  SHOVELS.forEach(s=>{ tbl.innerHTML += `<tr><td><b>${s.name}</b></td><td>${s.dig}</td><td>${s.speed}</td><td>${s.toughness}</td><td>${s.location}</td><td>${s.description||''}</td></tr>`; });
}
function renderSluices(){
  const tbl = document.getElementById('sluicesTable');
  if(!tbl) return;
  tbl.innerHTML = '<tr><th>Sluice</th><th>Luck</th><th>Capacity</th><th>Toughness</th><th>Efficiency</th><th>Lokasi</th><th>Deskripsi</th></tr>'; 
  SLUICES.forEach(s=>{ tbl.innerHTML += `<tr><td><b>${s.name}</b></td><td>${s.luck.toLocaleString('id-ID')}</td><td>${s.capacity}</td><td>${s.toughness}</td><td>${s.efficiency}</td><td>${s.location}</td><td>${s.description||''}</td></tr>`; });
}
const ENCH_TIER_TAG = {C:'common', B:'uncommon', A:'rare', S:'epic', 'S+':'mythic'};
function renderEnchants(){
  const panTbl = document.getElementById('enchantTablePan');
  const shovelTbl = document.getElementById('enchantTableShovel');
  if(panTbl){
    panTbl.innerHTML = '<tr><th>Enchantment</th><th>Efek</th><th>Roll Chance</th><th>Power Tier</th></tr>';
