  PANS.forEach(p=>{ tbl.innerHTML += `<tr><td><b>${p.name}</b></td><td>${p.luck}</td><td>${p.capacity}</td><td>${p.shake}</td><td>${p.speed}</td><td>${p.passive}</td><td>${p.location}</td><td>${p.description||''}</td></tr>`; });
}
