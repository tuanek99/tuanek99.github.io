function renderMuseumRecoPresets(){
  const wrap = document.getElementById('museumRecoPresets');
  if(!wrap) return;
  wrap.innerHTML = MUSEUM_RECO_PRESETS.map((p,i)=>`<button type="button" class="btn ghost" data-preset-idx="${i}">${p.label}</button>`).join('');
  wrap.querySelectorAll('[data-preset-idx]').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      const preset = MUSEUM_RECO_PRESETS[+btn.dataset.presetIdx];
      museumRecoSelectedStats = new Set(preset.stats);
      renderMuseumRecoStatPicker();
      generateMuseumRecommendation();
    });
  });
}
function renderMuseumRecoStatPicker(){
  const wrap = document.getElementById('museumRecoStatPicker');
  if(!wrap) return;
  wrap.innerHTML = MUSEUM_STAT_ORDER.map(stat=>{
    const active = museumRecoSelectedStats.has(stat);
    const color = MUSEUM_STAT_COLOR[stat] || 'var(--quartz)';
    return `<div class="card" data-reco-stat="${stat}" style="cursor:pointer;padding:12px 14px;${active?`border-color:${color};background:rgba(237,227,206,0.08);`:''}">
      <h3 style="margin:0;font-size:13.5px;color:${active?color:'var(--quartz)'};">${active?'✓ ':''}${MUSEUM_STAT_LABELS[stat]||stat}</h3>
    </div>`;
  }).join('');
  wrap.querySelectorAll('[data-reco-stat]').forEach(el=>{
    el.addEventListener('click', ()=>{
      const stat = el.dataset.recoStat;
      if(museumRecoSelectedStats.has(stat)) museumRecoSelectedStats.delete(stat); else museumRecoSelectedStats.add(stat);
      renderMuseumRecoStatPicker();
      generateMuseumRecommendation();
    });
  });
}
function clearMuseumRecoPicker(){
  museumRecoSelectedStats = new Set();
  museumRecoLastPlan = null;
  renderMuseumRecoStatPicker();
  const box = document.getElementById('museumRecoResult');
  if(box) box.innerHTML = '';
}
function museumModChanceNum(c){
  const m = /([\d.]+)%/.exec(c||'');
  return m ? parseFloat(m[1]) : -1;
}
function generateMuseumRecommendation(){
  const box = document.getElementById('museumRecoResult');
  if(!box) return;
  const targets = [...museumRecoSelectedStats];
  if(!targets.length){
    box.innerHTML = '<div class="notice small">Pilih minimal satu stat fokus dulu di atas (atau klik salah satu preset).</div>';
    return;
  }
  // Buat plan: tiap display slot diisi ore rarity-nya yang paling nyumbang ke stat pilihan (asumsi berat penuh sampai Minimum KG).
  const plan = [];
  const totals = {};
  const usedOreNames = new Set();
  MUSEUM_RARITIES.forEach(r=>{
    const slots = MUSEUM_DISPLAY_SLOTS[r] || 0;
    const scored = MUSEUM_ORES[r].map(o=>{
      let score = 0, contributes = [];
      o.boosts.forEach(b=>{ if(targets.includes(b.stat)){ score += b.max; contributes.push({stat:b.stat, val:b.max}); } });
      return {ore:o, score, contributes};
    }).sort((a,b)=> b.score - a.score || a.ore.minKg - b.ore.minKg);
    for(let i=1;i<=slots;i++){
      // Ambil kandidat terbaik yang belum pernah dipakai di display lain.
      // Jika tidak ada yang memberi bonus, tetap pilih ore unik untuk completion.
      const best = scored.find(item=>!usedOreNames.has(item.ore.name) && item.score > 0)
        || scored.find(item=>!usedOreNames.has(item.ore.name));
      if(best){
        usedOreNames.add(best.ore.name);
        plan.push({rarity:r, slotIdx:i, ore:best.ore, contributes:best.contributes});
        best.contributes.forEach(c=>{ totals[c.stat] = (totals[c.stat]||0) + c.val; });
      } else {
        plan.push({rarity:r, slotIdx:i, ore:null});
      }
    }
  });
  museumRecoLastPlan = plan;

  // Modifier yang relevan ke stat pilihan, diurutkan dari chance realistis tertinggi
  const relevantMods = MUSEUM_MODIFIERS.filter(m=> m.boosts.some(b=>targets.includes(b.stat)));
  relevantMods.sort((a,b)=> museumModChanceNum(b.chance) - museumModChanceNum(a.chance));

  const totalHtml = MUSEUM_STAT_ORDER.filter(s=>targets.includes(s)).map(stat=>{
    const val = totals[stat] || 0;
    const mult = 1 + val;
    const color = MUSEUM_STAT_COLOR[stat] || 'var(--quartz)';
    return `<div class="sitem"><b style="color:${color};">${MUSEUM_STAT_LABELS[stat]||stat}: x${mult.toFixed(2)}</b><span>dari ore museum aja (belum modifier)</span></div>`;
  }).join('');

  const modHtml = relevantMods.length ? relevantMods.map(m=>{
    const realistic = museumModChanceNum(m.chance) > 0;
    const boostTxt = m.boosts.length ? m.boosts.map(b=>MUSEUM_STAT_LABELS[b.stat]||b.stat).join(' + ') : '—';
    return `<div class="tstats-row"><span class="tstats-label">${m.name}${realistic?'':' <span style="opacity:.55;">(sumber spesial)</span>'}</span><span class="tstats-val">${boostTxt} · ${m.chance}</span></div>`;
  }).join('') : '<div class="tstats-row"><span class="tstats-label">Tidak ada modifier yang cocok.</span></div>';

  const planHtml = MUSEUM_RARITIES.map(r=>{
    const tagClass = MUSEUM_RARITY_TAGCLASS[r] || 'common';
    const rows = plan.filter(p=>p.rarity===r);
    const cards = rows.map(p=>{
      if(!p.ore){
        return `<div class="card"><h3><span class="tag ${tagClass}">${r}</span> <span style="color:var(--quartz-dim);font-weight:400;font-size:12px;">Display ${p.slotIdx}</span></h3><p>Nggak ada mineral ${r} yang nyumbang ke stat pilihanmu — isi bebas atau buat completion aja.</p></div>`;
      }
      const contribTxt = p.contributes.map(c=>`<span style="color:${MUSEUM_STAT_COLOR[c.stat]||'var(--quartz)'};font-weight:600;">+${(c.val*100).toFixed(1)}% ${MUSEUM_STAT_LABELS[c.stat]||c.stat} <span style="opacity:.68;font-weight:500;">(${c.val.toFixed(2)}×)</span></span>`).join(', ');
      return `<div class="card"><h3><span class="tag ${tagClass}">${r}</span> <span style="color:var(--quartz-dim);font-weight:400;font-size:12px;">Display ${p.slotIdx}</span></h3><p><b style="color:var(--quartz);">${p.ore.name}</b> — target berat <b>${p.ore.minKg} kg</b><br>${contribTxt}</p></div>`;
    }).join('');
    return `<div style="margin-bottom:18px;"><div class="rarity-heading grad-text grad-${r.toLowerCase()}" style="margin:0 0 8px;font-size:15px;">${r}</div><div class="grid cols-3">${cards}</div></div>`;
  }).join('');

  box.innerHTML = `
    <div class="resultbox" style="margin-bottom:16px;">
      <div style="font-weight:600;color:var(--quartz);margin-bottom:8px;">Potensi total ore museum (berat penuh)</div>
      <div class="statgrid">${totalHtml}</div>
    </div>
    <div style="margin-bottom:16px;">
      <div class="tstats-head">Modifier prioritas buat stat ini<span class="tstats-sub">Diurutkan dari chance tertinggi.</span></div>
      <div class="tstats-list">${modHtml}</div>
    </div>
    <div class="btnrow" style="margin-bottom:14px;"><button class="btn primary" onclick="applyMuseumRecommendationToPlanner()">↓ Terapkan ke Manage Museum</button></div>
    ${planHtml}
  `;
}
function applyMuseumRecommendationToPlanner(){
  if(!museumRecoLastPlan) return;
  const cards = document.querySelectorAll('#museumPlannerWrap [data-museum-slot]');
  let i = 0;
  cards.forEach(card=>{
    const p = museumRecoLastPlan[i++];
    if(!p) return;
    if(p.ore){
      card.querySelector('.mus-ore').value = p.ore.name;
      card.querySelector('.mus-weight').value = p.ore.minKg;
    } else {
      card.querySelector('.mus-ore').value = '';
      card.querySelector('.mus-weight').value = '';
    }
  });
  updateMuseumDisplayCounter();
  saveMuseumPlannerState();
  calcMuseumBuild();
  const target = document.getElementById('museumPlannerWrap');
  if(target) target.scrollIntoView({behavior:'smooth', block:'start'});
}

const MUTATIONS = [
  {name:"Silver", chance:"~15%", mult:"1.10×", bonus:"—"},
  {name:"Gold", chance:"~5.9%", mult:"1.20×", bonus:"—"},
  {name:"Diamond", chance:"~2.2%", mult:"1.35×", bonus:"—"},
  {name:"Granite", chance:"~0.88%", mult:"1.36×", bonus:"+24 Dig Strength, +6 Shake Strength"},
  {name:"Overclocked", chance:"~0.88%", mult:"1.36×", bonus:"+10% Dig Speed, +10% Shake Speed"},
  {name:"Festive", chance:"Event only (~2.2% saat event aktif)", mult:"1.40×", bonus:"+50 Luck, +10% Size Boost"},
  {name:"Prismatic", chance:"~0.44%", mult:"1.60×", bonus:"—"}
];

/* ================= INDEXEDDB + LOGIN + ROBLOX AVATAR (dipertahankan) ================= */
/* ================= INDEXEDDB HELPER (ganti localStorage) ================= */
/* Semua "pilihan terakhir" (tab aktif, filter, isian kalkulator, build
   bandingan, fokus planner, checklist) disimpan di sini, bukan lagi di
   localStorage. Kalau IndexedDB tidak tersedia, app tetap jalan tanpa
   penyimpanan (fallback diam-diam). */
const IDB_NAME = 'xprospecting_db';
const IDB_VERSION = 1;
const IDB_STORE = 'lastChoices';
function idbOpen(){
  return new Promise((resolve, reject)=>{
    if(!('indexedDB' in window)){ reject(new Error('IndexedDB tidak didukung browser ini')); return; }
    const req = indexedDB.open(IDB_NAME, IDB_VERSION);
    req.onupgradeneeded = ()=>{ if(!req.result.objectStoreNames.contains(IDB_STORE)) req.result.createObjectStore(IDB_STORE); };
    req.onsuccess = ()=> resolve(req.result);
    req.onerror = ()=> reject(req.error);
  });
}
const idbReady = idbOpen().catch(err=>{ console.warn('IndexedDB tidak tersedia, pilihan terakhir tidak akan tersimpan.', err); return null; });
async function idbGet(key, fallback){
  const db = await idbReady;
  if(!db) return fallback;
  try{
    const val = await new Promise((res, rej)=>{
      const tx = db.transaction(IDB_STORE, 'readonly');
      const rq = tx.objectStore(IDB_STORE).get(key);
      rq.onsuccess = ()=> res(rq.result);
      rq.onerror = ()=> rej(rq.error);
    });
    return val === undefined ? fallback : val;
  }catch(e){ console.warn('idbGet gagal untuk key', key, e); return fallback; }
}
async function idbSet(key, value){
  const db = await idbReady;
  if(!db) return false;
  try{
    await new Promise((res, rej)=>{
      const tx = db.transaction(IDB_STORE, 'readwrite');
      tx.objectStore(IDB_STORE).put(value, key);
      tx.oncomplete = ()=> res(true);
      tx.onerror = ()=> rej(tx.error);
    });
    return true;
  }catch(e){ console.warn('idbSet gagal untuk key', key, e); return false; }
}

/* ================= PROFILE / LOGIN (username + head icon Roblox) ================= */
const PROFILE_KEY = 'xprospecting_profile';
let currentProfile = null; // {username, userId, avatarUrl, guest, updatedAt}

/* Semua "pilihan terakhir" dinamespace per-username, supaya kalau ganti akun
   di browser yang sama, filter/kalkulator/checklist tidak kecampur. */
function userKey(key){
  const uname = (currentProfile && currentProfile.username) ? currentProfile.username : 'guest';
  return `u:${uname}:${key}`;
}
async function uGet(key, fallback){ return idbGet(userKey(key), fallback); }
async function uSet(key, value){ return idbSet(userKey(key), value); }

/* Pindahkan data lama (sebelum ada sistem login) ke akun yang baru login,
   supaya progres checklist/filter sebelumnya tidak hilang begitu saja. */
async function migrateLegacyDataIfNeeded(){
  const legacyKeys = ['lastPanel','mineralFilters','calcOddsState','compareState','plannerState','xprospecting_pans_v1','xprospecting_shovels_v1'];
  for(const k of legacyKeys){
    const already = await idbGet(userKey(k), undefined);
    if(already !== undefined) continue;
    const legacy = await idbGet(k, undefined);
    if(legacy !== undefined) await idbSet(userKey(k), legacy);
  }
}

function fetchWithTimeout(url, opts={}, ms=8000){
  const ctrl = new AbortController();
  const timer = setTimeout(()=> ctrl.abort(), ms);
  return fetch(url, {...opts, signal: ctrl.signal}).finally(()=> clearTimeout(timer));
}

/* Ambil userId + URL head icon dari username Roblox.
   Catatan: users.roblox.com / thumbnails.roblox.com MENOLAK fetch() langsung
   dari browser (Roblox tidak mengirim header Access-Control-Allow-Origin di
   endpoint ini) — jadi endpoint resmi (persis format yang diminta:
   thumbnails.roblox.com/v1/users/avatar-headshot?userIds=...&size=150x150&format=Png)
   tetap dipakai sebagai URL acuan, tapi harus dilewatkan proxy CORS. Supaya
   lebih tahan gangguan, sekarang dicoba BEBERAPA proxy berurutan, dan lookup
   username->userId dipindah ke endpoint GET dulu (bukan POST) karena banyak
   proxy publik gagal menangani preflight OPTIONS yang dipicu request POST +
   JSON body, sehingga request gagal diam-diam. Kalau semua proxy gagal,
   fungsi ini balikin null dan aplikasi otomatis fallback ke avatar inisial. */

function thumbAndUsersProxyCandidates(realUrl){
  const encoded = encodeURIComponent(realUrl);
  return [
    // 1) roproxy: proxy komunitas khusus domain roblox.com — path & query
    //    persis sama dengan endpoint resmi, cuma host-nya diganti.
    realUrl.replace('https://users.roblox.com', 'https://users.roproxy.com')
           .replace('https://thumbnails.roblox.com', 'https://thumbnails.roproxy.com'),
    // 2) fallback: proxy CORS generik yang membungkus URL ASLI Roblox apa adanya.
    `https://corsproxy.io/?url=${encoded}`,
    `https://api.allorigins.win/raw?url=${encoded}`
  ];
}

async function fetchJsonWithFallback(realUrl, opts){
  // Coba semua proxy PARALEL (bukan berurutan) dengan timeout lebih pendek per
  // proxy, supaya total waktu tunggu singkat — ini juga mengurangi risiko user
  // klik "Masuk" dua kali karena merasa prosesnya lama.
  const candidates = thumbAndUsersProxyCandidates(realUrl);
  const attempts = candidates.map(candidate =>
    fetchWithTimeout(candidate, opts, 6000)
      .then(res => res.ok ? res.json() : Promise.reject(new Error('HTTP '+res.status)))
      .then(json => { if(!json) throw new Error('JSON kosong'); return json; })
      .catch(e => { console.warn('Proxy gagal:', candidate, e); throw e; })
  );
  try{
    return await Promise.any(attempts);
  }catch(e){
    return null; // semua proxy gagal
  }
}

async function lookupRobloxUserId(username){
  // 1) GET /v1/users/search — "simple request", TIDAK memicu preflight OPTIONS,
  //    jauh lebih tahan terhadap proxy publik yang tidak menangani preflight.
  //    Response-nya juga sudah menyertakan field displayName.
  const searchUrl = `https://users.roblox.com/v1/users/search?keyword=${encodeURIComponent(username)}&limit=10`;
  const searchJson = await fetchJsonWithFallback(searchUrl);
  if(searchJson && Array.isArray(searchJson.data) && searchJson.data.length){
    const exact = searchJson.data.find(u => (u.name||'').toLowerCase() === username.toLowerCase());
    const pick = exact || searchJson.data[0];
    return { userId: pick.id, username: pick.name, displayName: pick.displayName || pick.name };
  }
  // 2) Fallback: endpoint POST lama (butuh proxy yang menangani preflight dengan benar).
  //    Endpoint ini juga menyertakan field displayName.
  try{
    const bulkRes = await fetchWithTimeout('https://users.roproxy.com/v1/usernames/users', {
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify({usernames:[username], excludeBannedUsers:true})
    });
    if(bulkRes.ok){
      const bulkJson = await bulkRes.json();
      if(bulkJson.data && bulkJson.data.length){
        const u = bulkJson.data[0];
        return { userId: u.id, username: u.name || username, displayName: u.displayName || u.name || username };
      }
    }
  }catch(e){
    console.warn('Fallback POST username lookup gagal:', e);
  }
  return null;
}

async function lookupHeadshotUrl(userId, attempt=0){
  // URL ASLI persis format resmi Roblox — ini yang dibungkus proxy di atas.
  const realUrl = `https://thumbnails.roblox.com/v1/users/avatar-headshot?userIds=${userId}&size=150x150&format=Png&isCircular=true`;
  const json = await fetchJsonWithFallback(realUrl);
  const entry = json && json.data && json.data[0];
  if(!entry) return null;
  // Kadang Roblox masih memproses thumbnail baru ("Pending") — coba ulang sebentar.
  if(entry.state === 'Pending' && attempt < 2){
    await new Promise(r=> setTimeout(r, 700));
    return lookupHeadshotUrl(userId, attempt+1);
  }
  return entry.imageUrl || null;
}

/* Cache avatar Roblox (IndexedDB, bukan localStorage) supaya tiap kali login
   ke akun yang sama tidak perlu hit proxy dari nol. Disimpan GLOBAL (bukan
   per-user seperti "pilihan terakhir" lain) karena key-nya sudah berupa
   username Roblox itu sendiri — jadi kalau dua orang pakai browser yang sama
   dan login sebagai akun yang sama, cache-nya memang boleh dipakai bareng. */
const AVATAR_CACHE_TTL_MS = 6 * 60 * 60 * 1000; // 6 jam
function avatarCacheKey(username){ return `avatarCache:${username.trim().toLowerCase()}`; }
async function getCachedAvatar(username){
  const cached = await idbGet(avatarCacheKey(username), null);
  if(cached && (Date.now() - cached.cachedAt) < AVATAR_CACHE_TTL_MS) return { ...cached, fromCache:true };
  return null;
}
async function setCachedAvatar(username, data){
  await idbSet(avatarCacheKey(username), { ...data, cachedAt: Date.now() });
}

async function fetchRobloxAvatar(username, { forceRefresh=false } = {}){
  if(!forceRefresh){
    const cached = await getCachedAvatar(username);
    if(cached) return cached;
  }
  try{
    const idResult = await lookupRobloxUserId(username);
    if(!idResult) return null;
    const avatarUrl = await lookupHeadshotUrl(idResult.userId);
    const data = { userId: idResult.userId, username: idResult.username, displayName: idResult.displayName, avatarUrl };
    await setCachedAvatar(username, data);
    return data;
  }catch(e){
    console.warn('Gagal ambil avatar Roblox (mungkin CORS/offline/semua proxy down):', e);
    return null;
  }
}

function setLoginStatus(msg){ document.getElementById('loginStatus').textContent = msg || ''; }
function showLoginOverlay(){
  const cancelBtn = document.getElementById('loginCancelBtn');
  cancelBtn.style.display = currentProfile ? 'block' : 'none';
  document.getElementById('loginUsernameInput').value = (currentProfile && !currentProfile.guest) ? currentProfile.username : '';
  setLoginStatus('');
  document.getElementById('loginOverlay').style.display = 'flex';
  document.getElementById('loginUsernameInput').focus();
}
function hideLoginOverlay(){ document.getElementById('loginOverlay').style.display = 'none'; }

function avatarFallbackImg(imgEl, initial){
  const div = document.createElement('div');
  div.className = 'profile-avatar-fallback';
  div.textContent = initial;
  imgEl.replaceWith(div);
}
function escapeHtml(str){
  return String(str||'').replace(/[&<>"']/g, c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}
function renderProfileHeadCard(){
  const wrap = document.getElementById('profileHeadCard');
  if(!wrap) return;
  if(!currentProfile){ wrap.innerHTML = ''; return; }
  const isGuest = currentProfile.guest;
  const displayName = isGuest ? 'Tamu' : (currentProfile.displayName || currentProfile.username);
  const username = currentProfile.username;
  const userId = isGuest ? '—' : (currentProfile.userId || 'Tidak tersedia');
  const initial = (displayName || '?').trim().charAt(0).toUpperCase() || '?';
  const avatarInner = currentProfile.avatarUrl
    ? `<img src="${currentProfile.avatarUrl}" alt="${escapeHtml(displayName)}" onerror="avatarFallbackImg(this,'${escapeHtml(initial)}')">`
    : `<div class="profile-avatar-fallback">${escapeHtml(initial)}</div>`;
  wrap.innerHTML = `
    <div class="profile-big-avatar">
      <div class="profile-avatar">${avatarInner}</div>
      <div>
        <div class="pb-name">${escapeHtml(displayName)}</div>
        <div class="pb-handle">@${escapeHtml(username)}</div>
        <div class="pb-id">ID: ${escapeHtml(userId)}</div>
      </div>
    </div>`;
}
function renderProfileCard(){
  const wrap = document.getElementById('profileCard');
  if(!currentProfile){ wrap.innerHTML = ''; return; }
  const isGuest = currentProfile.guest;
  const displayName = isGuest ? 'Tamu' : (currentProfile.displayName || currentProfile.username);
  const username = currentProfile.username;
  const initial = (displayName || '?').trim().charAt(0).toUpperCase() || '?';
  const avatarInner = currentProfile.avatarUrl
    ? `<img src="${currentProfile.avatarUrl}" alt="${escapeHtml(displayName)}" onerror="avatarFallbackImg(this,'${escapeHtml(initial)}')">`
    : `<div class="profile-avatar-fallback">${escapeHtml(initial)}</div>`;
  let roleText = '';
  if(!isGuest && !currentProfile.avatarUrl){
    roleText = currentProfile.userId ? 'Avatar tidak tersedia' : 'Username tidak ditemukan';
  }
  // Baris @username cuma ditampilkan kalau displayName berbeda dari username asli
  // (kalau user tidak pernah set display name custom, keduanya identik).
  const showHandleLine = !isGuest && displayName.toLowerCase() !== username.toLowerCase();
  wrap.innerHTML = `
    <div class="profile-avatar" role="button" tabindex="0" title="Lihat total stats" onclick="goTo('profile')" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();goTo('profile');}">${avatarInner}</div>
    <div class="profile-meta">
      <div class="profile-name">${escapeHtml(displayName)}</div>
      ${showHandleLine ? `<div class="profile-handle">@${escapeHtml(username)}</div>` : ''}
      ${roleText ? `<div class="profile-role">${roleText}</div>` : ''}
    </div>
    <div class="world-timers" id="worldTimers" aria-label="World Events and Timers">
      <div class="world-timers-head"><span>Event &amp; Timer</span></div>
      <div class="world-timers-row">
        <div class="world-timer" id="timerMerchant"><span class="world-timer-name">Traveling Merchant</span><span class="world-timer-status">CLOSED</span><span class="world-timer-state">Moves in</span><span class="world-timer-count">—</span></div>
        <div class="world-timer" id="timerInfernal"><span class="world-timer-name">Infernal Heart</span><span class="world-timer-status">CLOSED</span><span class="world-timer-state">Opens in</span><span class="world-timer-count">—</span></div>
        <div class="world-timer" id="timerTimelocked"><span class="world-timer-name">Timelocked Sanctuary</span><span class="world-timer-status">CLOSED</span><span class="world-timer-state">Opens in</span><span class="world-timer-count">—</span></div>
      </div>
    </div>
    <button class="profile-change-btn" onclick="event.stopPropagation(); showLoginOverlay()" title="Ganti pengguna" aria-label="Ganti pengguna">⇄</button>
  `;
  renderProfileHeadCard();
}

/* requestSeq mencegah race condition: kalau user sempat klik "Masuk" dua kali
   (misalnya karena proses proxy terasa lambat), hanya hasil dari request PALING
   BARU yang boleh menimpa currentProfile. Request lama yang selesai belakangan
   akan diabaikan — ini yang sebelumnya menyebabkan avatar "muncul lalu hilang". */
let loginRequestSeq = 0;

async function handleLoginSubmit(){
  const raw = document.getElementById('loginUsernameInput').value.trim();
  if(!raw){ setLoginStatus('Masukkan username terlebih dahulu.'); return; }

  const mySeq = ++loginRequestSeq;
  const submitBtn = document.querySelector('#loginOverlay .btn.primary');
  const prevBtnText = submitBtn ? submitBtn.textContent : '';
  if(submitBtn){ submitBtn.disabled = true; submitBtn.textContent = 'Memuat…'; }
  setLoginStatus('Memuat…');

  // Kalau usernamenya sama dengan yang sedang aktif, anggap ini permintaan
  // refresh manual (misalnya karena user baru ganti foto profil Roblox-nya)
  // dan lewati cache. Username lain tetap boleh pakai cache biar cepat.
  const forceRefresh = !!(currentProfile && !currentProfile.guest &&
    currentProfile.username.toLowerCase() === raw.toLowerCase());
  const result = await fetchRobloxAvatar(raw, { forceRefresh });

  if(mySeq !== loginRequestSeq){
    // Ada request login yang lebih baru sudah/sedang berjalan — buang hasil ini
    // supaya tidak menimpa profil yang sudah ditampilkan oleh request terbaru.
    return;
  }
  if(submitBtn){ submitBtn.disabled = false; submitBtn.textContent = prevBtnText || 'Masuk'; }

  currentProfile = result
    ? { username: result.username, displayName: result.displayName || result.username, userId: result.userId, avatarUrl: result.avatarUrl, guest:false, updatedAt: Date.now() }
    : { username: raw, displayName: raw, userId: null, avatarUrl: null, guest:false, updatedAt: Date.now() };
  await idbSet(PROFILE_KEY, currentProfile);
  await migrateLegacyDataIfNeeded();
  renderProfileCard();
  hideLoginOverlay();
  if(!result){
    setLoginStatus('');
  }
  await initApp();
}
async function handleGuestLogin(){
  currentProfile = { username:'guest', userId:null, avatarUrl:null, guest:true, updatedAt: Date.now() };
  await idbSet(PROFILE_KEY, currentProfile);
  await migrateLegacyDataIfNeeded();
  renderProfileCard();
  hideLoginOverlay();
  await initApp();
}
document.getElementById('loginUsernameInput').addEventListener('keydown', e=>{ if(e.key==='Enter') handleLoginSubmit(); });

async function bootstrapProfile(){
  const saved = await idbGet(PROFILE_KEY, null);
  if(saved){
    currentProfile = saved;
    renderProfileCard();
    hideLoginOverlay();
    await initApp();
  }else{
    showLoginOverlay();
  }
}

/* ================= WORLD EVENT TIMERS ================= */
function formatWorldCountdown(totalSeconds){
  let s=Math.max(0,Math.floor(totalSeconds));
  const d=Math.floor(s/86400); s%=86400;
  const h=Math.floor(s/3600); s%=3600;
  const m=Math.floor(s/60); s%=60;
  return `${d}d ${h}h ${m}m ${String(s).padStart(2,'0')}s`;
}
function utcSecondsNow(){
  const now=new Date();
  return now.getUTCHours()*3600+now.getUTCMinutes()*60+now.getUTCSeconds();
}
function secondsUntilMinuteMark(now, minute){
  // Infernal/Timelocked rotate every hour at :15 and :45, not once per day.
  const hour=now%3600, target=minute*60;
  return (target-hour+3600)%3600 || 3600;
}
function updateWorldTimers(){
  const now=utcSecondsNow();
  const merchant=document.getElementById('timerMerchant');
  const infernal=document.getElementById('timerInfernal');
  const timelocked=document.getElementById('timerTimelocked');
  if(!merchant || !infernal || !timelocked) return;
  const setStatus=(el,isLive,label)=>{
    el.classList.toggle('live',isLive); el.classList.toggle('closed',!isLive);
    const node=el.querySelector('.world-timer-status');
    if(node) node.textContent=label;
  };
  setStatus(merchant,false,'CLOSED');
  merchant.querySelector('.world-timer-state').textContent='Moves in';
  merchant.querySelector('.world-timer-count').textContent=formatWorldCountdown(86400-now);
  const minute=Math.floor(now/60)%60;
  const infernalOpen=minute>=15 && minute<45;
  const timelockedOpen=minute>=45 || minute<15;
  const setCycle=(el,isOpen,openAt,closeAt)=>{
    el.classList.toggle('open',isOpen); el.classList.toggle('closed',!isOpen);
    setStatus(el,isOpen,isOpen?'LIVE':'CLOSED');
    // Match the wiki's display: always count down to the next opening mark.
    el.querySelector('.world-timer-state').textContent='Opens in';
    el.querySelector('.world-timer-count').textContent=formatWorldCountdown(secondsUntilMinuteMark(now,openAt));
  };
  setCycle(infernal,infernalOpen,15,45);
  setCycle(timelocked,timelockedOpen,45,15);
}
updateWorldTimers();
setInterval(updateWorldTimers,1000);

/* ================= NAV ================= */
const navitems = [...document.querySelectorAll('.navitem')];
const panels = document.querySelectorAll('.panel');
function goTo(targetId, persist=true, focusNav=false){
  navitems.forEach(n=>{ n.classList.remove('active'); n.setAttribute('aria-selected','false'); n.tabIndex = -1; });
  panels.forEach(p=>p.classList.remove('active'));
  let nav = navitems.find(n=>n.dataset.target===targetId);
  let panel = document.getElementById(targetId);
  if(!panel){
    targetId = 'dropcalc';
    nav = navitems.find(n=>n.dataset.target==='dropcalc');
    panel = document.getElementById('dropcalc');
  }
  if(nav){
    nav.classList.add('active');
    nav.setAttribute('aria-selected','true');
    nav.tabIndex = 0;
    if(focusNav) nav.focus();
  }
  panel.classList.add('active');
  if(targetId==='dropcalc') setTimeout(()=>{if(typeof updateExternalLoadoutSummary==='function') updateExternalLoadoutSummary();},0);
  window.scrollTo({top:0, behavior:'instant'});
  if(persist) uSet('lastPanel', targetId);
}
navitems.forEach((item, idx)=>{
  item.addEventListener('click', ()=> goTo(item.dataset.target));
  item.addEventListener('keydown', e=>{
    const key = e.key;
    if(key==='Enter' || key===' '){
      e.preventDefault();
      goTo(item.dataset.target);
      return;
    }
    let nextIdx = null;
    if(key==='ArrowDown') nextIdx = (idx+1) % navitems.length;
    else if(key==='ArrowUp') nextIdx = (idx-1+navitems.length) % navitems.length;
    else if(key==='Home') nextIdx = 0;
    else if(key==='End') nextIdx = navitems.length-1;
    if(nextIdx !== null){
      e.preventDefault();
      navitems[idx].tabIndex = -1;
      navitems[nextIdx].tabIndex = 0;
      navitems[nextIdx].focus();
    }
  });
});
function tagFor(rarity){ return `<span class="tag ${String(rarity).toLowerCase()}">${rarity}</span>`; }
const toolTabButtons=[...document.querySelectorAll('#toolsTabSeg [data-tooltab]')];
const toolPanels={pans:document.getElementById('toolPanelPans'),shovels:document.getElementById('toolPanelShovels'),sluices:document.getElementById('toolPanelSluices')};
toolTabButtons.forEach(btn=>btn.addEventListener('click',()=>{
  const target=btn.dataset.tooltab;
  toolTabButtons.forEach(b=>{b.classList.toggle('active',b===btn);b.setAttribute('aria-selected',b===btn?'true':'false');});
  Object.entries(toolPanels).forEach(([key,el])=>{if(el) el.style.display=key===target?'':'none';});
}));

/* ================= MINERALS TABLE ================= */
function allMineralLocations(){
  const set = new Set();
  MINERALS.forEach(m=> (m.locations||[]).forEach(l=> set.add(l)));
  return [...set].sort();
}
function populateMineralLocFilter(){
  const sel = document.getElementById('mineralLocFilter');
  allMineralLocations().forEach(loc=>{
    const opt = document.createElement('option');
    opt.value = loc; opt.textContent = loc;
    sel.appendChild(opt);
  });
}
populateMineralLocFilter();
function renderMinerals(rarityFilter, locFilter){
  rarityFilter = rarityFilter || 'all';
  locFilter = locFilter || 'all';
  const tbl = document.getElementById('mineralTable');
  tbl.innerHTML = '<tr><th>Mineral</th><th>Rarity</th><th>Lokasi</th><th>Nilai jual</th><th>Catatan</th></tr>';
  MINERALS
    .filter(m=> rarityFilter==='all' || m.rarity===rarityFilter)
    .filter(m=> locFilter==='all' || (m.locations||[]).includes(locFilter))
    .forEach(m=>{
      const locText = (m.locations && m.locations.length) ? m.locations.join(', ') : 'Belum dikonfirmasi — cek wiki Minerals';
      tbl.innerHTML += `<tr><td>${m.name}</td><td>${tagFor(m.rarity)}</td><td style="font-size:12px;">${locText}</td><td>${m.value}</td><td>${m.note}</td></tr>`;
    });
}
function onMineralFilterChange(){
  const rarity = document.getElementById('mineralFilter').value;
  const loc = document.getElementById('mineralLocFilter').value;
  renderMinerals(rarity, loc);
  uSet('mineralFilters', {rarity, loc});
}
document.getElementById('mineralFilter').addEventListener('change', onMineralFilterChange);
document.getElementById('mineralLocFilter').addEventListener('change', onMineralFilterChange);

