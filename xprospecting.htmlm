      const tagClass = ENCH_TIER_TAG[e.tier] || 'common';
      panTbl.innerHTML += `<tr><td><b>${e.name}</b></td><td>${e.effect}</td><td>${e.chance}</td><td><span class="tag ${tagClass}">${e.tier}</span></td></tr>`;
    });
  }
  if(shovelTbl){
    shovelTbl.innerHTML = '<tr><th>Enchantment</th><th>Efek</th><th>Catatan</th></tr>';
    SHOVEL_ENCHANTS.forEach(e=>{ shovelTbl.innerHTML += `<tr><td><b>${e.name}</b></td><td>${e.effect}</td><td>${e.note}</td></tr>`; });
  }
}
document.querySelectorAll('#enchanting .segctrl .seg[data-enchtab]').forEach(btn=>{
  btn.addEventListener('click', ()=>{
    document.querySelectorAll('#enchanting .segctrl .seg[data-enchtab]').forEach(b=>{ b.classList.remove('active'); b.setAttribute('aria-selected','false'); });
    btn.classList.add('active'); btn.setAttribute('aria-selected','true');
    const isPan = btn.dataset.enchtab === 'pan';
    document.getElementById('enchPanWrap').style.display = isPan ? '' : 'none';
    document.getElementById('enchShovelWrap').style.display = isPan ? 'none' : '';
  });
});
function initInternalDropCalculator(){
  const mineralSel=document.getElementById('dcMineral'), locSel=document.getElementById('dcLocation'); if(!mineralSel||!locSel)return;
  const totals=typeof sumLoadoutStats==='function'?sumLoadoutStats():{};
  const activeLuck=totals['Luck']?.max, activeCap=totals['Capacity']?.max;
  if(Number.isFinite(activeLuck)){document.getElementById('dcLuck').value=activeLuck.toFixed(2);document.getElementById('luckInput').value=activeLuck;}
  if(Number.isFinite(activeCap)){document.getElementById('dcCap').value=activeCap;document.getElementById('capInput').value=activeCap;}
  const names=[...new Set(EXTERNAL_ODDS.map(x=>x.mineral))].sort(); mineralSel.innerHTML=names.map(n=>`<option value="${escapeHtml(n)}">${escapeHtml(n)}</option>`).join('');
  const selected=getSelectedMineral(); if(selected&&names.includes(selected.name)) mineralSel.value=selected.name;
  function refreshLocations(){const e=EXTERNAL_ODDS.find(x=>x.mineral===mineralSel.value);const locs=(e?.locations||[]).map(x=>x.location);locSel.innerHTML=locs.map(x=>`<option value="${escapeHtml(x)}">${escapeHtml(x)}</option>`).join(''); calculate();}
  function calculate(){const e=EXTERNAL_ODDS.find(x=>x.mineral===mineralSel.value), loc=e?.locations?.find(x=>x.location===locSel.value)||e?.locations?.[0]; if(!e||!loc)return; const luck=Math.max(0,Number(document.getElementById('dcLuck').value)||0), cap=Math.max(1,Number(document.getElementById('dcCap').value)||1), rolls=Math.max(1,luck*Math.sqrt(cap)), base=Number(loc.chance_percent)||0, p=Math.min(1,1-Math.pow(1-base/100,rolls)); const attempts=q=>p>0?Math.ceil(Math.log(1-q)/Math.log(1-p)):Infinity; const cycle=typeof simValues==='function'?simValues().cycle:0, pansHour=cycle>0?3600/cycle:0, expectedHour=pansHour*p; const fmtPct=x=>x<0.0001?x.toExponential(3)+'%':x.toLocaleString('id-ID',{maximumFractionDigits:6})+'%'; const fmtN=x=>Number.isFinite(x)?x.toLocaleString('id-ID'):'—';
    document.getElementById('dcActiveTarget').textContent=mineralSel.value; document.getElementById('dcActiveMeta').textContent=loc.location+' · '+fmtPct(base)+' base chance'; document.getElementById('dcRollsOut').textContent=rolls.toLocaleString('id-ID',{maximumFractionDigits:2}); document.getElementById('dcBaseOut').textContent=fmtPct(base); document.getElementById('dcAttemptOut').textContent=fmtPct(p*100); document.getElementById('dcCycleOut').textContent=cycle.toFixed(2)+'s'; document.getElementById('dcDifficultyOut').textContent=p>=.5?'Relatif mudah':'Relatif sulit'; document.getElementById('dcExpectedOut').textContent=expectedHour.toFixed(4)+' expected finds / hour · ~'+fmtN(pansHour)+' pans/hour'; document.getElementById('dc50Out').textContent=fmtN(attempts(.5))+' pan'; document.getElementById('dc90Out').textContent=fmtN(attempts(.9))+' pan'; document.getElementById('dc99Out').textContent=fmtN(attempts(.99))+' pan'; document.getElementById('dcTableNote').textContent=names.length+' minerals in local odds data'; const table=document.getElementById('dcLocationsTable'); table.innerHTML='<tr><th>Location</th><th>Base chance / roll</th><th>Chance / pan</th><th>50% attempts</th><th>90% attempts</th></tr>'+e.locations.map(x=>{const bp=Number(x.chance_percent)||0,pp=Math.min(1,1-Math.pow(1-bp/100,rolls));const a=q=>pp>0?Math.ceil(Math.log(1-q)/Math.log(1-pp)):Infinity;return `<tr><td>${escapeHtml(x.location)}</td><td>${fmtPct(bp)}</td><td>${fmtPct(pp*100)}</td><td>${fmtN(a(.5))}</td><td>${fmtN(a(.9))}</td></tr>`}).join('');
  }
  mineralSel.addEventListener('change',refreshLocations); locSel.addEventListener('change',calculate); ['dcLuck','dcCap'].forEach(id=>document.getElementById(id).addEventListener('input',calculate)); refreshLocations();
}
function updateExternalLoadoutSummary(){
  const t=document.getElementById('externalTargetReadout'), l=document.getElementById('externalLuckReadout'), c=document.getElementById('externalCapReadout'), g=document.getElementById('externalGearReadout');
  if(!t)return;
  const selected=typeof getSelectedMineral==='function'?getSelectedMineral():null; const target=selected?.name||'Belum dipilih';
  const totals=typeof sumLoadoutStats==='function'?sumLoadoutStats():{};
  if(t)t.textContent=target;
  if(l)l.textContent=totals['Luck']?.max??'—';
  if(c)c.textContent=totals['Capacity']?.max??'—';
  const pan=document.getElementById('kitPanSelect')?.value||'—', shovel=document.getElementById('kitShovelSelect')?.value||'—';
  if(g)g.textContent=pan+' / '+shovel;
}
function renderEvents(){
  const t=document.getElementById('eventsTable'); if(!t)return;
  t.innerHTML='<tr><th>Event</th><th>Jadwal / Durasi</th><th>Area</th><th>Efek utama</th><th>Relic / Pemicu</th></tr>'+EVENTS.map(e=>'<tr><td><b>'+escapeHtml(e.name)+'</b></td><td>'+escapeHtml(e.schedule)+'</td><td>'+escapeHtml(e.area)+'</td><td>'+escapeHtml(e.effect)+'</td><td>'+escapeHtml(e.trigger)+'</td></tr>').join('');
}
renderEvents();
setTimeout(()=>{if(typeof initInternalDropCalculator==='function')initInternalDropCalculator();if(typeof updateExternalLoadoutSummary==='function')updateExternalLoadoutSummary();},0);
renderPans();
renderShovels();
renderSluices();
renderEnchants();

/* ================= MUSEUM ================= */
function formatBoost(b){
  const sign = b.max < 0 ? '−' : '+';
  return `${sign}${Math.abs(b.max)}× ${b.stat}`;
}
function oreBonusDisplay(ore){ return ore.boosts.map(formatBoost).join(', '); }
let museumActiveRarity = 'Common';
function renderMuseumRaritySeg(){
  const seg = document.getElementById('museumRaritySeg');
  if(!seg) return;
  seg.innerHTML = MUSEUM_RARITIES.map(r=>`<button type="button" class="seg${r===museumActiveRarity?' active':''}" data-rarity="${r}">${r}</button>`).join('');
  seg.querySelectorAll('.seg').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      museumActiveRarity = btn.dataset.rarity;
      seg.querySelectorAll('.seg').forEach(b=>b.classList.toggle('active', b===btn));
      renderMuseumOreTable();
    });
  });
}
function renderMuseumOreTable(){
  const tbl = document.getElementById('museumOreTable');
  if(!tbl) return;
  const list = MUSEUM_ORES[museumActiveRarity] || [];
  tbl.innerHTML = '<tr><th>Ore</th><th>Minimum KG</th><th>Bonus</th><th>Maximum Boost</th></tr>';
  list.forEach(o=>{
    const maxTxt = o.boosts.map(b=>`${b.max<0?'−':''}${Math.abs(b.max)}×`).join(', ');
    const bonusTxt = o.boosts.map(b=>`<span style="color:${MUSEUM_STAT_COLOR[b.stat]||'var(--quartz)'};font-weight:600;">${b.stat}</span>`).join(', ');
    tbl.innerHTML += `<tr><td><b>${o.name}</b></td><td>${o.minKg}</td><td>${bonusTxt}</td><td>${maxTxt}</td></tr>`;
  });
}
function renderMuseumModifierTable(){
  const tbl = document.getElementById('museumModifierTable');
  if(!tbl) return;
  tbl.innerHTML = '<tr><th>Modifier</th><th>Bonus</th><th>Chance</th></tr>';
  MUSEUM_MODIFIERS.forEach(m=>{
    const bonusTxt = m.boosts.length ? m.boosts.map(b=>`<span style="color:${MUSEUM_STAT_COLOR[b.stat]||'var(--quartz)'};font-weight:600;">${b.stat}</span>${b.note?` (${b.note})`:''}`).join(' + ') : '(none)';
    tbl.innerHTML += `<tr><td><b>${m.name}</b></td><td>${bonusTxt}</td><td>${m.chance}</td></tr>`;
  });
}
function renderMuseumMultiplierTable(){
  const tbl = document.getElementById('museumMultiplierTable');
  if(!tbl) return;
  tbl.innerHTML = '<tr><th>Rarity</th><th>Multiplier</th></tr>';
  MUSEUM_RARITIES.forEach(r=>{
    const tagClass = MUSEUM_RARITY_TAGCLASS[r] || 'common';
    tbl.innerHTML += `<tr><td><span class="tag ${tagClass}">${r}</span></td><td>${MUSEUM_MOD_MULT[r]}×</td></tr>`;
  });
}
function newMuseumBuildId(){ return 'b'+Date.now().toString(36)+Math.random().toString(36).slice(2,7); }
function emptyMuseumSlots(){ return Array.from({length: MUSEUM_TOTAL_DISPLAYS}, ()=>({ore:'',weight:'',mod:''})); }
function ensureAtLeastOneMuseumBuild(){
  if(!Array.isArray(MUSEUM_BUILDS) || !MUSEUM_BUILDS.length){
    const id = newMuseumBuildId();
    MUSEUM_BUILDS = [{id, name:'Museum 1', slots: emptyMuseumSlots()}];
    museumActiveBuildId = id;
  }
  if(!MUSEUM_BUILDS.find(b=>b.id===museumActiveBuildId)) museumActiveBuildId = MUSEUM_BUILDS[0].id;
}
function getActiveMuseumBuild(){
  ensureAtLeastOneMuseumBuild();
  return MUSEUM_BUILDS.find(b=>b.id===museumActiveBuildId);
}
function saveMuseumBuilds(){ uSet('museumBuilds', MUSEUM_BUILDS); uSet('museumActiveBuildId', museumActiveBuildId); }
function renderMuseumBuildList(){
  const wrap = document.getElementById('museumBuildList');
  if(!wrap) return;
  ensureAtLeastOneMuseumBuild();
  wrap.innerHTML = MUSEUM_BUILDS.map(b=>`<span class="museum-build-chip">
    <button type="button" class="btn museum-build-select${b.id===museumActiveBuildId?' primary':' ghost'}" data-build-id="${b.id}">${escapeHtml(b.name)}</button>
    <button type="button" class="museum-build-icon" data-rename-build="${b.id}" title="Ganti nama ${escapeHtml(b.name)}" aria-label="Ganti nama ${escapeHtml(b.name)}">✎</button>
    <button type="button" class="museum-build-icon danger" data-delete-build="${b.id}" title="Hapus ${escapeHtml(b.name)}" aria-label="Hapus ${escapeHtml(b.name)}">×</button>
  </span>`).join('') +
    `<button type="button" class="btn ghost" id="museumAddBuildBtn">+ Build Baru</button>`;
  wrap.querySelectorAll('[data-build-id]').forEach(btn=>{
    btn.addEventListener('click', ()=> switchMuseumBuild(btn.dataset.buildId));
  });
  wrap.querySelectorAll('[data-rename-build]').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      if(btn.dataset.renameBuild===museumActiveBuildId) renameMuseumBuild();
      else { museumActiveBuildId=btn.dataset.renameBuild; renameMuseumBuild(); }
    });
  });
  wrap.querySelectorAll('[data-delete-build]').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      if(btn.dataset.deleteBuild!==museumActiveBuildId) switchMuseumBuild(btn.dataset.deleteBuild);
      deleteMuseumBuild();
    });
  });
  const addBtn = document.getElementById('museumAddBuildBtn');
  if(addBtn) addBtn.addEventListener('click', addMuseumBuild);
}
function resetMuseumBuildResultBox(){
  const box = document.getElementById('museumBuildResult');
  if(box) box.innerHTML = 'Total stats diperbarui otomatis.';
}
function addMuseumBuild(){
  const name = prompt('Nama build baru:', `Museum ${MUSEUM_BUILDS.length+1}`);
  if(name===null) return;
  const id = newMuseumBuildId();
  MUSEUM_BUILDS.push({id, name: name.trim() || `Museum ${MUSEUM_BUILDS.length+1}`, slots: emptyMuseumSlots()});
  museumActiveBuildId = id;
  saveMuseumBuilds();
  renderMuseumBuildList();
  renderMuseumPlanner();
  resetMuseumBuildResultBox();
}
function renameMuseumBuild(){
  const build = getActiveMuseumBuild();
  const name = prompt('Ganti nama build:', build.name);
  if(name===null) return;
  build.name = name.trim() || build.name;
  saveMuseumBuilds();
  renderMuseumBuildList();
}
function deleteMuseumBuild(){
  ensureAtLeastOneMuseumBuild();
  if(MUSEUM_BUILDS.length<=1){ alert('Minimal harus ada 1 build.'); return; }
  const build = getActiveMuseumBuild();
  if(!confirm(`Hapus build "${build.name}"? Ini nggak bisa dibatalkan.`)) return;
  MUSEUM_BUILDS = MUSEUM_BUILDS.filter(b=>b.id!==build.id);
  museumActiveBuildId = MUSEUM_BUILDS[0].id;
  saveMuseumBuilds();
  renderMuseumBuildList();
  renderMuseumPlanner();
  resetMuseumBuildResultBox();
}
function switchMuseumBuild(id){
  if(id===museumActiveBuildId) return;
  saveMuseumPlannerState();
  museumActiveBuildId = id;
  saveMuseumBuilds();
  renderMuseumBuildList();
  renderMuseumPlanner();
  resetMuseumBuildResultBox();
}
function renderMuseumPlanner(){
  const wrap = document.getElementById('museumPlannerWrap');
  if(!wrap) return;
  wrap.innerHTML = MUSEUM_RARITIES.map(r=>{
    const tagClass = MUSEUM_RARITY_TAGCLASS[r] || 'common';
    const slots = MUSEUM_DISPLAY_SLOTS[r] || 0;
    const oreOptions = ['<option value="">— kosong —</option>'].concat(MUSEUM_ORES[r].map(o=>`<option value="${o.name}">${o.name} (min ${o.minKg}kg)</option>`)).join('');
    const modOptions = ['<option value="">Tanpa modifier</option>'].concat(MUSEUM_MODIFIERS.map(m=>`<option value="${m.name}">${m.name}</option>`)).join('');
    let cardsHtml = '';
    for(let i=1;i<=slots;i++){
      cardsHtml += `<div class="card" data-museum-slot="${r}">
        <h3><span class="tag ${tagClass}">${r}</span> <span style="color:var(--quartz-dim);font-weight:400;font-size:12px;">Display ${i}/${slots}</span></h3>
        <div class="field"><label>Mineral</label><select class="mus-ore">${oreOptions}</select></div>
        <div class="field"><label>Berat (kg)</label><input type="number" class="mus-weight" min="0" step="0.5" placeholder="mis. ${MUSEUM_ORES[r][0]?MUSEUM_ORES[r][0].minKg:20}"></div>
        <div class="field" style="margin-bottom:0;"><label>Modifier (opsional)</label><select class="mus-mod">${modOptions}</select></div>
      </div>`;
    }
    return `<div style="margin-bottom:22px;">
      <div class="rarity-heading grad-text grad-${r.toLowerCase()}" style="margin:0 0 10px;">${r} <span style="font-size:12px;color:var(--quartz-dim);-webkit-text-fill-color:var(--quartz-dim);">· ${slots} display</span></div>
      <div class="grid cols-3">${cardsHtml}</div>
    </div>`;
  }).join('');
  wrap.querySelectorAll('.mus-ore, .mus-mod').forEach(el=>el.addEventListener('change', ()=>{ updateMuseumDisplayCounter(); saveMuseumPlannerState(); calcMuseumBuild(); renderTotalStats(); syncDropTargetFromMineral(); }));
  wrap.querySelectorAll('.mus-weight').forEach(el=>el.addEventListener('input', ()=>{ saveMuseumPlannerState(); calcMuseumBuild(); renderTotalStats(); syncDropTargetFromMineral(); }));
  restoreMuseumPlannerState(getActiveMuseumBuild().slots);
  calcMuseumBuild();
}
function getMuseumPlannerState(){
  return [...document.querySelectorAll('#museumPlannerWrap [data-museum-slot]')].map(card=>({
    ore: card.querySelector('.mus-ore').value,
    weight: card.querySelector('.mus-weight').value,
    mod: card.querySelector('.mus-mod').value
  }));
}
function saveMuseumPlannerState(){
  const build = getActiveMuseumBuild();
  build.slots = getMuseumPlannerState();
  saveMuseumBuilds();
  calcMuseumBuild();
}
function restoreMuseumPlannerState(state){
  if(!Array.isArray(state)) return;
  const cards = document.querySelectorAll('#museumPlannerWrap [data-museum-slot]');
  cards.forEach((card,i)=>{
    const s = state[i];
    if(!s) return;
    card.querySelector('.mus-ore').value = s.ore || '';
    card.querySelector('.mus-weight').value = s.weight || '';
    card.querySelector('.mus-mod').value = s.mod || '';
  });
  updateMuseumDisplayCounter();
}
function updateMuseumDisplayCounter(){
  const el = document.getElementById('museumDisplayCounter');
  if(!el) return;
  const cards = document.querySelectorAll('#museumPlannerWrap [data-museum-slot]');
  let filled = 0;
  cards.forEach(card=>{
    const oreName = card.querySelector('.mus-ore').value;
    const modName = card.querySelector('.mus-mod').value;
    if(oreName || modName) filled++;
  });
  el.querySelector('.num').textContent = `${filled} / ${MUSEUM_TOTAL_DISPLAYS}`;
}
function calcMuseumBuild(){
  const totals = {};
  const cards = document.querySelectorAll('#museumPlannerWrap [data-museum-slot]');
  let filled = 0;
  cards.forEach(card=>{
    const rarity = card.dataset.museumSlot;
    const oreName = card.querySelector('.mus-ore').value;
    const weight = parseFloat(card.querySelector('.mus-weight').value) || 0;
    const modName = card.querySelector('.mus-mod').value;
    let used = false;
    if(oreName){
      used = true;
      const ore = MUSEUM_ORES[rarity].find(o=>o.name===oreName);
      if(ore){
        const ratio = ore.minKg>0 ? Math.min(Math.max(weight,0)/ore.minKg, 1) : 1;
        ore.boosts.forEach(b=>{ totals[b.stat] = (totals[b.stat]||0) + b.max*ratio; });
      }
    }
    if(modName){
      used = true;
      const mod = MUSEUM_MODIFIERS.find(m=>m.name===modName);
      const mult = MUSEUM_MOD_MULT[rarity] * (modName==='Treasured' ? 2 : 1);
      if(mod){ mod.boosts.forEach(b=>{ totals[b.stat] = (totals[b.stat]||0) + mult; }); }
    }
    if(used) filled++;
  });
  updateMuseumDisplayCounter();
  const box = document.getElementById('museumBuildResult');
  if(!box) return;
  if(!filled){ box.innerHTML = 'Isi minimal satu Display untuk melihat total stats.'; return; }
  const rows = MUSEUM_STAT_ORDER.filter(stat=>Math.abs(totals[stat]||0)>0.00001).map(stat=>[stat, totals[stat]]);
  Object.keys(totals).forEach(stat=>{
    if(!MUSEUM_STAT_ORDER.includes(stat) && Math.abs(totals[stat])>0.00001) rows.push([stat, totals[stat]]);
  });
  if(!rows.length){ box.innerHTML = 'Belum ada bonus. Isi berat mineral untuk menghitungnya.'; return; }
  box.innerHTML = '<div style="font-weight:600;color:var(--quartz);margin-bottom:10px;">Total Stats Museum (gaya Manage Museum in-game)</div><div class="statgrid">' +
    rows.map(([stat,val])=>{
      const mult = 1 + val;
      const label = MUSEUM_STAT_LABELS[stat] || stat.replace(/\s+/g,'');
      const color = val<0 ? 'var(--rust)' : 'var(--malachite)';
      return `<div class="sitem"><b style="color:${color};">${label}: x${mult.toFixed(2)}</b></div>`;
    }).join('') +
    '</div>';
}
function resetMuseumBuild(){
  document.querySelectorAll('#museumPlannerWrap [data-museum-slot]').forEach(card=>{
    card.querySelector('.mus-ore').value = '';
    card.querySelector('.mus-weight').value = '';
    card.querySelector('.mus-mod').value = '';
  });
  updateMuseumDisplayCounter();
  saveMuseumPlannerState();
  const box = document.getElementById('museumBuildResult');
  if(box) box.innerHTML = 'Isi minimal satu Display untuk melihat total stats.';
}
renderMuseumRaritySeg();
renderMuseumOreTable();
renderMuseumModifierTable();
renderMuseumMultiplierTable();
renderMuseumRecoPresets();
renderMuseumRecoStatPicker();
renderMuseumBuildList();
renderMuseumPlanner();

/* ================= MUTATION FORGE ================= */
function renderMutationTable(){
  const tbl = document.getElementById('mutationTable');
  if(!tbl) return;
  tbl.innerHTML = '<tr><th>Mutasi</th><th>Peluang dasar</th><th>Pengali</th><th>Bonus tambahan</th></tr>';
  MUTATIONS.forEach(m=>{ tbl.innerHTML += `<tr><td><b>${m.name}</b></td><td>${m.chance}</td><td>${m.mult}</td><td>${m.bonus}</td></tr>`; });
}
/* Ekstrak material katalis (ditandai " c" di akhir token pada string recipe)
   dari tiap resep equipment untuk tabel "List of Equipment Catalysts". */
function extractCatalyst(recipe){
  if(!recipe) return null;
  const m = recipe.match(/(\d+)\s+([A-Za-z][A-Za-z' ]*?)\s+c(?=\s|$)/);
  return m ? m[2].trim() : null;
}
function renderCatalystTable(slotFilter){
  slotFilter = slotFilter || 'all';
  const tbl = document.getElementById('catalystTable');
  if(!tbl) return;
  tbl.innerHTML = '<tr><th>Equipment</th><th>Slot</th><th>Katalis</th><th>Resep lengkap</th></tr>';
  EQUIPMENT_DATA
    .filter(e=> slotFilter==='all' || e.slot===slotFilter)
    .forEach(e=>{
      const cat = extractCatalyst(e.recipe) || '—';
      tbl.innerHTML += `<tr><td><b>${e.name}</b></td><td>${e.slot}</td><td>${cat}</td><td style="font-size:12px;">${(e.recipe||'').replace(/\s+c(?=\s|$)/,' (katalis)')}</td></tr>`;
    });
}
document.getElementById('catalystSlotFilter').addEventListener('change', e=> renderCatalystTable(e.target.value));
renderMutationTable();
renderCatalystTable('all');

/* ================= KIT: REKOMENDASI OTOMATIS DARI MINERAL ================= */
const RARITY_ORDER = ['Common','Uncommon','Rare','Epic','Legendary','Mythic','Exotic','Ascended'];

/* ================= TOTAL STATS (dihitung dari Loadout Equipment: Neck+Charm+Ring) ================= */
const STAT_ORDER = ['Luck','Dig Strength','Capacity','Dig Speed','Shake Strength','Inventory Size','Shake Speed','Treasure Map Chance','Sell Boost','Size Boost','Status Timer Speed','Modifier Boost','WalkSpeed','Jump Power','Toughness','Efficiency'];
const STAT_IS_PERCENT = {'Dig Speed':true,'Shake Speed':true,'Modifier Boost':true,'Sell Boost':true,'Size Boost':true,'Status Timer Speed':true,'Treasure Map Chance':true};
const STAT_COLOR = {
  'Luck':'var(--malachite)','Dig Strength':'var(--rust)','Capacity':'var(--sapphire)','Dig Speed':'var(--sapphire)',
  'Shake Strength':'var(--copper)','Inventory Size':'var(--copper)','Shake Speed':'var(--malachite)',
  'Treasure Map Chance':'var(--gold)','Sell Boost':'var(--gold)','Size Boost':'var(--rust)',
  'Status Timer Speed':'#B15CFF','Modifier Boost':'var(--malachite)','WalkSpeed':'var(--quartz)','Jump Power':'var(--copper)','Toughness':'var(--rust)','Efficiency':'var(--gold)'
};
// Urutan dari nama terpanjang/paling spesifik dulu supaya tidak salah cocok antar stat yang prefix-nya mirip
const STAT_NAME_LIST = ['Status Timer Speed','Treasure Map Chance','Modifier Boost','Inventory Size','Shake Strength','Dig Strength','Shake Speed','Size Boost','Sell Boost','Jump Power','Dig Speed','WalkSpeed','Walkspeed','Capacity','Luck'];

function parseStatsString(str){
  // Ubah teks "stats" equipment (mis. "Dig Strength 0.2 – 1.1 · Capacity 0 – 5.5") jadi {StatName:{min,max}}
  const out = {};
  if(!str) return out;
  str.split('·').forEach(seg=>{
    seg = seg.trim();
    if(!seg) return;
    const lower = seg.toLowerCase();
    const nameRaw = STAT_NAME_LIST.find(n=> lower.startsWith(n.toLowerCase()));
    if(!nameRaw) return;
    const name = nameRaw==='Walkspeed' ? 'WalkSpeed' : nameRaw;
    const rest = seg.slice(nameRaw.length);
    const nums = rest.match(/[+\-−]?\d[\d,]*(?:\.\d+)?/g);
    if(!nums || !nums.length) return;
    const vals = nums.map(n=> parseFloat(n.replace(/,/g,'').replace('−','-')));
    const min = Math.min(...vals), max = Math.max(...vals);
    if(!out[name]) out[name] = {min:0,max:0};
    out[name].min += min;
    out[name].max += max;
  });
  return out;
}
function emptyStatTotals(){
  const totals = {};
  STAT_ORDER.forEach(s=> totals[s] = {min:0,max:0});
  return totals;
}
function addStat(totals, stat, min, max){
  if(!totals[stat]) totals[stat]={min:0,max:0};
  totals[stat].min += Number(min)||0; totals[stat].max += Number(max)||0;
}
function addEquipmentStats(totals){
  [...document.querySelectorAll('#kitLoadout select')].forEach(sel=>{
    const item=EQUIPMENT_DATA.find(e=>e.name===sel.value); if(!item) return;
    const parsed=parseStatsString(item.stats);
    Object.keys(parsed).forEach(stat=>addStat(totals,stat,parsed[stat].min,parsed[stat].max));
  });
}
function addGearStats(totals){
  const pan=PANS.find(x=>x.name===document.getElementById('kitPanSelect')?.value);
  const shovel=SHOVELS.find(x=>x.name===document.getElementById('kitShovelSelect')?.value);
  const sluice=SLUICES.find(x=>x.name===document.getElementById('kitSluiceSelect')?.value);
  if(pan){ addStat(totals,'Luck',pan.luck,pan.luck); addStat(totals,'Capacity',pan.capacity,pan.capacity); addStat(totals,'Shake Strength',pan.shake,pan.shake); addStat(totals,'Shake Speed',pan.speed,pan.speed); }
  if(shovel){ addStat(totals,'Dig Strength',shovel.dig,shovel.dig); addStat(totals,'Dig Speed',shovel.speed,shovel.speed); addStat(totals,'Toughness',shovel.toughness,shovel.toughness); }
  if(sluice){ addStat(totals,'Luck',sluice.luck,sluice.luck); addStat(totals,'Capacity',sluice.capacity,sluice.capacity); addStat(totals,'Toughness',sluice.toughness,sluice.toughness); addStat(totals,'Efficiency',sluice.efficiency,sluice.efficiency); }
}
function runeEffects(){
  const names=[...document.querySelectorAll('#kitRuneSlots select')].map(s=>s.value).filter(Boolean);
  const totals={};
  names.forEach(name=>{
    const r=RUNE_DATA.find(x=>x.name===name); if(!r) return;
    const text=r.effect||'';
    const pct=text.match(/([+-]?\d+(?:\.\d+)?)%/);
    const val=pct ? parseFloat(pct[1])/100 : null;
    if(val===null) return;
    if(/Luck/i.test(text)) addStat(totals,'Luck',val,val);
    if(/Size/i.test(text)) addStat(totals,'Size Boost',val,val);
    if(/Dig\/Shake Speed/i.test(text)){ addStat(totals,'Dig Speed',val,val); addStat(totals,'Shake Speed',val,val); }
  });
  return {names,totals};
}
function sumLoadoutStats(){
  const totals=emptyStatTotals(); addEquipmentStats(totals); addGearStats(totals); const museum=getMuseumStatTotals(); Object.keys(museum).forEach(stat=>addStat(totals,stat,museum[stat],museum[stat]));
  const rune=runeEffects(); Object.keys(rune.totals).forEach(stat=>addStat(totals,stat,rune.totals[stat].min,rune.totals[stat].max));
  return totals;
}
function renderTotalStats(){
  const wrap=document.getElementById('totalStatsOut'); if(!wrap) return;
  const totals=sumLoadoutStats(); updateDropInputsFromLoadout(); const target=getSelectedMineral(); const targetOdds=getTargetOdds(target); const fmt=n=>{const r=Math.round(n*100)/100;return r.toLocaleString('id-ID');};
  const rows=STAT_ORDER.map(stat=>{const t=totals[stat]||{min:0,max:0};const pct=STAT_IS_PERCENT[stat]?'%':'';const color=STAT_COLOR[stat]||'var(--quartz)';return '<div class="tstats-row"><span class="tstats-label">'+escapeHtml(stat)+'</span><span class="tstats-val" style="color:'+color+'">'+fmt(t.max)+' ('+fmt(t.min)+')'+pct+'</span></div>';}).join('');
  const gearNames=['kitPanSelect','kitShovelSelect','kitSluiceSelect'].map(id=>document.getElementById(id)?.value).filter(Boolean);
  const rune=runeEffects();
  wrap.innerHTML='<div class="tstats-head">Total Stats<span class="tstats-sub">Gabungan equipment, pan, shovel, sluice, rune, dan Museum yang terisi.</span></div><div class="tstats-list">'+rows+'</div>';
}

function rarityIdx(r){ const i = RARITY_ORDER.indexOf(r); return i<0?0:i; }
function parsePriceNum(p){
  if(p===undefined||p===null) return Infinity;
  const s = String(p).trim();
  if(!s || s==='—') return Infinity;
  const n = parseFloat(s.replace(/[^0-9.]/g,''));
  return isNaN(n) ? Infinity : n;
}
function pickByRarityIdx(list, idx){
  if(!list || !list.length) return null;
  const t = Math.round((idx/(RARITY_ORDER.length-1)) * (list.length-1));
  return list[Math.max(0, Math.min(list.length-1, t))];
}
function locMatch(a,b){
  if(!a||!b) return false;
  const na = a.toLowerCase().replace(/s\b/,'').trim();
  const nb = b.toLowerCase().replace(/s\b/,'').trim();
  return na===nb || na.includes(nb) || nb.includes(na);
}
function mineralLocationList(m){
  // lokasi terbaik (dari data odds eksternal) diprioritaskan, lalu sisa lokasi dari data mineral
  const info = bestLocationsFor(m.name);
  const ranked = info ? info.sorted.map(x=>x.location) : [];
  const fallback = (m.locations||[]);
  const seen = new Set();
  return [...ranked, ...fallback].filter(l=>{ if(seen.has(l)) return false; seen.add(l); return true; });
}
function pickGearByLocation(list, locations, statKey){
  for(const loc of locations){
    const matches = list.filter(x=>locMatch(x.location, loc));
    if(matches.length){
      matches.sort((a,b)=> (b[statKey]||0) - (a[statKey]||0));
      return { item: matches[0], matchedLocation: loc };
    }
  }
  return null;
}
function equipmentPoolForSlot(slot){
  return EQUIPMENT_DATA
    .filter(e=> e.slot===slot && /luck/i.test(e.fit||'') && parsePriceNum(e.price)!==Infinity)
    .sort((a,b)=> parsePriceNum(a.price)-parsePriceNum(b.price));
}
function recommendRunesFor(m, count){
  const locs = mineralLocationList(m);
  const idx = rarityIdx(m.rarity);
  const isVolcanic = locs.some(l=>/magma|volcanic|infernal/i.test(l));
  const isDark = locs.some(l=>/abyssal|haunted|grotto|deeproot|void/i.test(l));
  const out = [];
  if(isVolcanic) out.push('Volcanic');
  else if(isDark) out.push('Abyssal');
  if(idx>=4 && !out.includes('Purity')) out.push('Purity');
  const filler = ['Purity','Discovery','Sunblessed','Critical II','Explorer','Speed I','Summit Seeker','Annihilation I'];
  for(const f of filler){ if(out.length>=count) break; if(!out.includes(f)) out.push(f); }
  return out.slice(0, count);
}
function computeKitRecommendation(m){
  const idx = rarityIdx(m.rarity);
  const locs = mineralLocationList(m);
  const necklace = pickByRarityIdx(equipmentPoolForSlot('Necklace'), idx);
  const charm = pickByRarityIdx(equipmentPoolForSlot('Charm'), idx);
  const ring = pickByRarityIdx(equipmentPoolForSlot('Ring'), idx);
  const panMatch = pickGearByLocation(PANS, locs, 'luck') || {item: pickByRarityIdx([...PANS].sort((a,b)=>a.luck-b.luck), idx), matchedLocation:null};
  const shovelMatch = pickGearByLocation(SHOVELS, locs, 'dig') || {item: pickByRarityIdx([...SHOVELS].sort((a,b)=>a.dig-b.dig), idx), matchedLocation:null};
  const sluiceMatch = pickGearByLocation(SLUICES, locs, 'luck') || {item: pickByRarityIdx([...SLUICES].sort((a,b)=>a.luck-b.luck), idx), matchedLocation:null};
  const runeCount = parseInt(document.getElementById('kitRuneCount').value)||5;
  const runes = recommendRunesFor(m, runeCount);
  return { necklace, charm, ring, pan:panMatch, shovel:shovelMatch, sluice:sluiceMatch, runes, bestLoc: locs[0]||null };
}
function applyKitRecommendation(m){
  const banner = document.getElementById('kitAutoBanner');
  if(!m){ if(banner) banner.innerHTML = 'Pilih mineral di <b>Minerals</b> untuk mengisi rekomendasi kit.'; renderTotalStats(); return; }
  const rec = computeKitRecommendation(m);
  if(banner) banner.innerHTML = `<span style="color:var(--gold);font-weight:700;">Recommendation by Ghost.Ai</span><br>💎 Ore: <b>${escapeHtml(m.name)}</b> ${tagFor(m.rarity)}<br>⛰️ Best Location: <b>${escapeHtml(rec.bestLoc||'—')}</b><br><a href="#" onclick="goTo('minerals');return false;" style="color:var(--gold);text-decoration:none;">click here to change mineral/ore!</a>`;

  // Rekomendasi equipment otomatis berdasarkan mineral yang dipilih.
  // Pan/Shovel tetap memakai starter default; Sluice tetap opsional.
  const selects = [...document.querySelectorAll('#kitLoadout select')];
  if(selects[0] && rec.necklace) selects[0].value = rec.necklace.name;
  if(selects[1] && rec.charm) selects[1].value = rec.charm.name;
  for(let i=2;i<selects.length;i++){ if(rec.ring) selects[i].value = rec.ring.name; }
  saveKitState();
  const runeSelects = [...document.querySelectorAll('#kitRuneSlots select')];
  runeSelects.forEach((sel,i)=>{ if(rec.runes[i]) sel.value = rec.runes[i]; });
  saveKitRuneState();
  resetAutoRateFromLoadout();
  renderTotalStats();
}

/* ================= SHARED TARGET / ODDS STATE ================= */
const DEFAULT_PAN = 'Rusty Pan';
const DEFAULT_SHOVEL = 'Rusty Shovel';
function getSelectedMineral(){
  const name = document.getElementById('calcMineralSelect')?.value;
  return MINERALS.find(x=>x.name===name) || null;
}
function getTargetOdds(mineral){
  if(!mineral) return {location:null, basePercent:0, all:[]};
  const info = bestLocationsFor(mineral.name);
  const location = info?.best?.[0] || mineral.locations?.[0] || null;
  const row = info?.sorted?.find(x=>x.location===location) || info?.sorted?.[0];
  return {location:location || row?.location || null, basePercent:Number(row?.chance_percent || 0), all:info?.sorted || []};
}
function getMuseumStatTotals(){
  const totals = {};
  document.querySelectorAll('#museumPlannerWrap [data-museum-slot]').forEach(card=>{
    const rarity=card.dataset.museumSlot;
    const oreName=card.querySelector('.mus-ore')?.value;
    const weight=parseFloat(card.querySelector('.mus-weight')?.value)||0;
    const modName=card.querySelector('.mus-mod')?.value;
    if(oreName){
      const ore=MUSEUM_ORES[rarity]?.find(o=>o.name===oreName);
      if(ore){ const ratio=ore.minKg>0?Math.min(Math.max(weight,0)/ore.minKg,1):1; ore.boosts.forEach(b=>totals[b.stat]=(totals[b.stat]||0)+b.max*ratio); }
    }
    if(modName){
      const mod=MUSEUM_MODIFIERS.find(m=>m.name===modName);
      const mult=(MUSEUM_MOD_MULT[rarity]||0)*(modName==='Treasured'?2:1);
      mod?.boosts?.forEach(b=>totals[b.stat]=(totals[b.stat]||0)+mult);
    }
  });
  return totals;
}
let autoRateManual=false;
function resetAutoRateFromLoadout(){
  autoRateManual=false;
  updateDropInputsFromLoadout();
  simRender();
}
function getAutoShakeRate(){
  const pan=PANS.find(x=>x.name===document.getElementById('kitPanSelect')?.value);
  const totals=sumLoadoutStats();
  const active=totals['Shake Speed']?.max;
  return Math.max(0.01,(active!=null?active:(pan?.speed||1))*2.5);
}
function getAutoCycleSeconds(shakeRate=getAutoShakeRate()){
  const pan=PANS.find(x=>x.name===document.getElementById('kitPanSelect')?.value);
  const shovel=SHOVELS.find(x=>x.name===document.getElementById('kitShovelSelect')?.value);
  const totals=sumLoadoutStats();
  const capacity=Math.max(1,totals.Capacity?.max||pan?.capacity||1);
  const shakeStrength=Math.max(0.05,pan?.shake||1);
  const shakeSpeed=Math.max(0.05,pan?.speed||1);
  const digSpeed=Math.max(1,(shovel?.speed||1)*100);
  const digs=Math.max(1,Math.ceil(capacity/shakeStrength));
  // Model autopan yang sama bentuknya dengan kalkulator komunitas:
  // cycle = shake phase + setup + dig phase. Gear aktif menentukan semua input.
  const shakePhase=(capacity/shakeStrength)/Math.max(0.01,shakeRate);
  const digPhase=digs*(143.9*Math.pow(digSpeed,-0.9324));
  const cycleSeconds=Math.max(0.25,shakePhase+1.15+digPhase);
  return cycleSeconds;
}
function updateDropInputsFromLoadout(){
  const totals=sumLoadoutStats();
  const capInput=document.getElementById('capInput'), luckInput=document.getElementById('luckInput'), rateInput=document.getElementById('rateInput');
  if(capInput && document.activeElement!==capInput) capInput.value=Math.max(1,totals.Capacity?.max||1);
  if(luckInput && document.activeElement!==luckInput) luckInput.value=Math.max(0,totals.Luck?.max||0);
  
}
function syncDropTargetFromMineral(){
  autoRateManual=false;
  const mineral=getSelectedMineral(), target=getTargetOdds(mineral);
  const title=document.getElementById('simTargetTitle'), meta=document.getElementById('simTargetMeta'), odds=document.getElementById('oddsInput');
  if(title) title.innerHTML=mineral?`${escapeHtml(mineral.name)} ${tagFor(mineral.rarity)}`:'Pilih mineral terlebih dahulu';
  if(meta) meta.textContent=mineral?`Lokasi: ${target.location||'—'} · Base odds: ${target.basePercent?target.basePercent+'% per roll':'belum tersedia'}`:'Buka tab Minerals dan pilih ore untuk memulai tes.';
  if(odds) odds.value=target.basePercent||0;
  updateDropInputsFromLoadout();
  simRender();
}

var simState={progress:0,pans:0,rolls:0,drops:0,auto:false,raf:null,lastTs:null,elapsed:0,phase:'dig',meter:0,meterDir:1,holding:false,holdRaf:null};

/* ================= MINERAL CALCULATOR ================= */
function bestLocationsFor(mineralName){
  const entry = EXTERNAL_ODDS.find(x=>x.mineral===mineralName);
  if(!entry || !entry.locations || !entry.locations.length) return null;
  const sorted = [...entry.locations].sort((a,b)=> b.chance_percent - a.chance_percent);
  const top = sorted[0].chance_percent;
  const ties = sorted.filter(x=> top>0 && Math.abs(x.chance_percent-top)/top < 0.02);
  return { sorted, best: ties.map(x=>x.location) };
}
function populateMineralCalcSelect(){
  const sel = document.getElementById('calcMineralSelect');
  const rarity = document.getElementById('calcRarityFilterSelect').value;
  const list = MINERALS.filter(m=> rarity==='all' || m.rarity===rarity);
  const prevVal = sel.value;
  sel.innerHTML = list.map(m=>`<option value="${escapeHtml(m.name)}">${escapeHtml(m.name)} — ${m.rarity}</option>`).join('');
  if(list.some(m=>m.name===prevVal)) sel.value = prevVal;
  renderMineralCalc();
}
function renderMineralCalc(persist=true){
  const name = document.getElementById('calcMineralSelect').value;
  const m = MINERALS.find(x=>x.name===name);
  const out = document.getElementById('mineralCalcOut');
  const oddsTbl = document.getElementById('mineralOddsTable');
  if(!m){ out.innerHTML = '<p style="color:var(--quartz-dim)">Pilih mineral untuk melihat detail.</p>'; oddsTbl.innerHTML=''; renderTotalStats(); return; }
  const info = bestLocationsFor(m.name);
  const bestLocText = info && info.best.length ? info.best.join(' / ') : ((m.locations && m.locations[0]) || 'Cek wiki Locations');
  out.innerHTML = `
    <h3 style="display:flex;align-items:center;gap:10px;margin-bottom:10px;">${escapeHtml(m.name)} ${tagFor(m.rarity)}</h3>
    <div class="statgrid">
      <div class="sitem"><b>${escapeHtml(m.value)}</b><span>Value</span></div>
      <div class="sitem"><b>${escapeHtml(bestLocText)}</b><span>Best Location</span></div>
    </div>
    <p style="margin-top:10px;">${escapeHtml(m.note||'')}</p>`;
  oddsTbl.innerHTML = '<tr><th>Lokasi</th><th>Peluang per roll</th></tr>';
  if(info){
    info.sorted.forEach(loc=>{
      oddsTbl.innerHTML += `<tr><td>${escapeHtml(loc.location)}</td><td>${loc.chance_percent}%</td></tr>`;
    });
  } else {
    (m.locations||[]).forEach(loc=>{ oddsTbl.innerHTML += `<tr><td>${escapeHtml(loc)}</td><td>—</td></tr>`; });
    if(!m.locations || !m.locations.length) oddsTbl.innerHTML += '<tr><td colspan="2">Data peluang belum tersedia.</td></tr>';
  }
  if(persist) uSet('mineralCalcState', {name, rarity: document.getElementById('calcRarityFilterSelect').value});
  applyKitRecommendation(m);
}
document.getElementById('calcRarityFilterSelect').addEventListener('change', populateMineralCalcSelect);
document.getElementById('calcMineralSelect').addEventListener('change', ()=>{ renderMineralCalc(); syncDropTargetFromMineral(); });
populateMineralCalcSelect();

/* ================= DROP CALCULATOR (stats cepat) ================= */
function simValues(){
  updateDropInputsFromLoadout();
  const cap=Math.max(1,parseFloat(document.getElementById('capInput').value)||1);
  const luck=Math.max(0,parseFloat(document.getElementById('luckInput').value)||0);
  const basePercent=Math.max(0,parseFloat(document.getElementById('oddsInput').value)||0);
  const shakeRate=Math.max(0.01,getAutoShakeRate());
  const pan=PANS.find(x=>x.name===document.getElementById('kitPanSelect')?.value);
  const shovel=SHOVELS.find(x=>x.name===document.getElementById('kitShovelSelect')?.value);
  const totals=sumLoadoutStats();
  const digStrength=Math.max(0.05,totals['Dig Strength']?.max||shovel?.strength||1);
  const digSpeed=Math.max(0.05,totals['Dig Speed']?.max||shovel?.speed||0.8);
  const shakeStrength=Math.max(0.05,totals['Shake Strength']?.max||pan?.shake||1);
  const digSeconds=Math.max(0.25,(cap/digStrength)*0.35/Math.max(0.1,digSpeed));
  const shakeSeconds=Math.max(0.25,(cap/shakeStrength)*0.5/shakeRate);
  const cycle=digSeconds+shakeSeconds, rate=3600/cycle;
  return {cap,luck,basePercent,shakeRate,digStrength,digSpeed,shakeStrength,digSeconds,shakeSeconds,cycle,rate};
}
function simRender(){
  const v=simValues();
  const lr=document.getElementById('dropLuckReadout'), cr=document.getElementById('dropCapReadout'), or=document.getElementById('dropOddsReadout'), cyc=document.getElementById('dropCycleReadout');
  if(lr) lr.textContent=v.luck.toLocaleString('id-ID'); if(cr) cr.textContent=v.cap.toLocaleString('id-ID'); if(or) or.textContent=v.basePercent+'%'; if(cyc) cyc.textContent=v.cycle.toFixed(2)+'s';
  const pRoll=v.basePercent/100, perPan=pRoll>0?1-Math.pow(1-pRoll,v.luck*Math.sqrt(v.cap)):0, chance=perPan*100;
  const fill=document.getElementById('simProgressFill'); if(fill) fill.style.width=simState.progress+'%';
  const pt=document.getElementById('simProgressText'); if(pt) pt.textContent=Math.round(simState.progress)+'%';
  const phase=document.getElementById('simPhaseLabel'); if(phase) phase.textContent=simState.phase==='dig'?'DIG · isi material':'SHAKE · ayak material';
  const out=document.getElementById('calcStatOut'); if(out) out.innerHTML='<div class="sim-stat"><b>'+simState.pans.toLocaleString('id-ID')+'</b><span>Completed pans</span></div><div class="sim-stat"><b>'+simState.rolls.toFixed(2)+'</b><span>Total effective rolls</span></div><div class="sim-stat"><b>'+chance.toPrecision(6)+'%</b><span>Chance per completed pan</span></div><div class="sim-stat"><b>'+simState.drops+'</b><span>Estimated drops in run</span></div>';
  const st=document.getElementById('simStatus'); if(st) st.textContent=simState.auto?'AUTO DIG + SHAKE':'MANUAL READY';
  const manualBtn=document.getElementById('simManualBtn'), autoBtn=document.getElementById('simAutoBtn');
  if(manualBtn) manualBtn.classList.toggle('active',!simState.auto);
  if(autoBtn) autoBtn.classList.toggle('active',simState.auto);
  const foot=document.getElementById('simFooter'); if(foot) foot.textContent=simState.auto?'Auto Dig + Shake realtime — Dig '+v.digSeconds.toFixed(2)+'s · Shake '+v.shakeSeconds.toFixed(2)+'s.':'Manual mode active.';
}
function simCompletePan(v){simState.pans++;simState.rolls+=v.luck*Math.sqrt(v.cap);const chance=1-Math.pow(1-v.basePercent/100,v.luck*Math.sqrt(v.cap));if(Math.random()<chance)simState.drops++;}
function simApplyHold(quality){
  const v=simValues(), strength=simState.phase==='dig'?v.digStrength:v.shakeStrength;
  const contribution=Math.min(1,strength/v.cap)*(0.25+0.75*Math.max(0,Math.min(1,quality)));
  simState.elapsed+=(simState.phase==='dig'?v.digSeconds:v.shakeSeconds)*contribution;
  while(simState.elapsed>=v.cycle){simState.elapsed-=v.cycle;simCompletePan(v);}
  simState.phase=simState.elapsed<v.digSeconds?'dig':'shake';
  const phaseStart=simState.phase==='dig'?0:v.digSeconds, phaseLen=simState.phase==='dig'?v.digSeconds:v.shakeSeconds;
  simState.progress=Math.min(99.999,Math.max(0,(simState.elapsed-phaseStart)/phaseLen*100));
  simRender();
}
function simHoldFrame(ts){
  if(!simState.holding)return;
  if(!simState.lastTs)simState.lastTs=ts;
  const v=simValues(), speed=simState.phase==='dig'?Math.max(.1,v.digSpeed):Math.max(.1,v.shakeRate);
  simState.meter+=simState.meterDir*(ts-simState.lastTs)/1000*(100/Math.max(1.2,3/speed));
  simState.lastTs=ts;
  if(simState.meter>=100){simState.meter=100;simState.meterDir=-1;}
  if(simState.meter<=0){simState.meter=0;simState.meterDir=1;}
  simState.progress=Math.round(simState.meter*100)/100;
  simRender(); simState.holdRaf=requestAnimationFrame(simHoldFrame);
}
function simHoldStart(e){
  if(simState.auto)return;
  e.preventDefault(); simState.holding=true; simState.lastTs=null;
  if(e.currentTarget?.setPointerCapture && e.pointerId!=null)e.currentTarget.setPointerCapture(e.pointerId);
  if(simState.holdRaf===null)simState.holdRaf=requestAnimationFrame(simHoldFrame);
}
function simHoldEnd(e){
  if(!simState.holding)return;
  e?.preventDefault?.(); simState.holding=false;
  if(simState.holdRaf!==null)cancelAnimationFrame(simState.holdRaf);
  simState.holdRaf=null; simState.lastTs=null;
  simApplyHold(simState.meter/100);
  simState.meter=0; simState.meterDir=1; simState.progress=0; simRender();
}
function simAutoFrame(ts){
  if(!simState.auto)return;
  if(simState.lastTs===null)simState.lastTs=ts;
  const v=simValues(), speed=simState.phase==='dig'?Math.max(.1,v.digSpeed):Math.max(.1,v.shakeRate);
  simState.meter+=simState.meterDir*(ts-simState.lastTs)/1000*(100/Math.max(1.2,3/speed));
  simState.lastTs=ts;
  if(simState.meter>=100){simState.meter=100;simState.meterDir=-1;}
  if(simState.meter<=0){simState.meter=0;simState.meterDir=1;}
  if(simState.meter>=51 && simState.meterDir===1){simApplyHold(.51);simState.meter=0;simState.meterDir=1;}
  simState.progress=simState.meter; simRender(); simState.raf=requestAnimationFrame(simAutoFrame);
}
function simSetMode(auto){if(auto!==simState.auto)simToggleAuto();}
function simToggleAuto(){if(simState.auto){simState.auto=false;if(simState.raf!==null)cancelAnimationFrame(simState.raf);simState.raf=null;simState.lastTs=null;}else{simState.auto=true;simState.lastTs=null;simState.raf=requestAnimationFrame(simAutoFrame);}simRender();}
function simReset(){if(simState.raf!==null)cancelAnimationFrame(simState.raf);simState={progress:0,pans:0,rolls:0,drops:0,auto:false,raf:null,lastTs:null,elapsed:0,phase:'dig',meter:0,meterDir:1,holding:false,holdRaf:null};simRender();}
function calcAll(persist=true){simRender();if(persist)uSet('calcOddsState',simValues());}


simRender();

/* ================= KIT: LOADOUT EQUIPMENT ================= */
function equipmentOptions(slot, selected){
  const list = EQUIPMENT_DATA.filter(x=>x.slot===slot);
  return '<option value="">— kosong / pilih nanti —</option>'+list.map(x=>`<option value="${escapeHtml(x.name)}" ${x.name===selected?'selected':''}>${escapeHtml(x.name)} · ${x.rarity}</option>`).join('');
}
function gearOptions(list, selected){ return '<option value="">— kosong / pilih nanti —</option>'+list.map(x=>'<option value="'+escapeHtml(x.name)+'" '+(x.name===selected?'selected':'')+'>'+escapeHtml(x.name)+'</option>').join(''); }
async function renderKitGear(){
  const saved=await uGet('kitGearState',null);
  {
    const pan=document.getElementById('kitPanSelect'), shovel=document.getElementById('kitShovelSelect'), sluice=document.getElementById('kitSluiceSelect');
    if(!pan||!shovel||!sluice) return;
    pan.innerHTML=gearOptions(PANS,saved?.pan || DEFAULT_PAN); shovel.innerHTML=gearOptions(SHOVELS,saved?.shovel || DEFAULT_SHOVEL); sluice.innerHTML=gearOptions(SLUICES,saved?.sluice || '');
    [pan,shovel,sluice].forEach(el=>el.addEventListener('change',()=>{uSet('kitGearState',{pan:pan.value,shovel:shovel.value,sluice:sluice.value});resetAutoRateFromLoadout();renderTotalStats();}));
    renderTotalStats();
  }
}
function renderKitLoadout(){
  const ringCount = parseInt(document.getElementById('kitRingCount').value)||8;
  const wrap = document.getElementById('kitLoadout');
  let html = `<div class="loadout-slot"><span class="slot-label">Neck</span><select onchange="saveKitState()">${equipmentOptions('Necklace')}</select></div>`;
  html += `<div class="loadout-slot"><span class="slot-label">Charm</span><select onchange="saveKitState()">${equipmentOptions('Charm')}</select></div>`;
  for(let i=1;i<=ringCount;i++){
    html += `<div class="loadout-slot"><span class="slot-label">Ring ${i}</span><select onchange="saveKitState()">${equipmentOptions('Ring')}</select></div>`;
  }
  wrap.innerHTML = html;
}
function saveKitState(){
  const ringCount = document.getElementById('kitRingCount').value;
  const selects = [...document.querySelectorAll('#kitLoadout select')].map(s=>s.value);
  uSet('kitLoadoutState', {ringCount, selects});
  autoRateManual=false;
  renderTotalStats();
}
document.getElementById('kitRingCount').addEventListener('change', ()=>{ autoRateManual=false; renderKitLoadout(); saveKitState(); resetAutoRateFromLoadout(); });

/* ================= KIT: RUNES ================= */
function runeOptions(selected){
  return '<option value="">— kosong / pilih nanti —</option>'+RUNE_DATA.map(r=>`<option value="${escapeHtml(r.name)}" ${r.name===selected?'selected':''}>${escapeHtml(r.name)} — ${escapeHtml(r.effect)}</option>`).join('');
}
function renderKitRunes(){
  const count = parseInt(document.getElementById('kitRuneCount').value)||5;
  const wrap = document.getElementById('kitRuneSlots');
  let html = '';
  for(let i=1;i<=count;i++){
    html += `<div class="loadout-slot"><span class="slot-label">Slot ${i}</span><select onchange="saveKitRuneState()">${runeOptions()}</select></div>`;
  }
  wrap.innerHTML = html;
}
function saveKitRuneState(){
  const count = document.getElementById('kitRuneCount').value;
  const selects = [...document.querySelectorAll('#kitRuneSlots select')].map(s=>s.value);
  uSet('kitRuneState', {count, selects});
  autoRateManual=false;
  renderTotalStats();
}
document.getElementById('kitRuneCount').addEventListener('change', ()=>{ autoRateManual=false; renderKitRunes(); saveKitRuneState(); resetAutoRateFromLoadout(); });

/* ================= GLOBAL SEARCH ================= */
const SEARCH_INDEX = [
  ...MINERALS.map(m=>({label:m.name, cat:'Mineral', target:'minerals'})),
  ...PANS.map(p=>({label:p.name, cat:'Pan', target:'tools'})),
  ...SHOVELS.map(s=>({label:s.name, cat:'Shovel', target:'tools'})),
  ...SLUICES.map(s=>({label:s.name, cat:'Sluice', target:'tools'})),
  ...EQUIPMENT_DATA.map(e=>({label:e.name, cat:'Equipment', target:'forge'})),
  ...PAN_ENCHANTS.map(e=>({label:e.name, cat:'Enchant (Pan)', target:'enchanting'})),
  ...SHOVEL_ENCHANTS.map(e=>({label:e.name, cat:'Enchant (Shovel)', target:'enchanting'})),
  ...RUNE_DATA.map(r=>({label:r.name, cat:'Rune', target:'mineralcalc'}))
];
const searchInput = document.getElementById('globalSearch');
const searchResults = document.getElementById('searchResults');
let searchActiveIndex = -1;
function closeSearchResults(){
  searchResults.classList.remove('show');
  searchInput.setAttribute('aria-expanded','false');
  searchInput.removeAttribute('aria-activedescendant');
  searchActiveIndex = -1;
}
function currentSearchItems(){ return [...searchResults.querySelectorAll('.sres-item')]; }
function highlightSearchItem(idx){
  const items = currentSearchItems();
  if(!items.length) return;
  searchActiveIndex = (idx + items.length) % items.length;
  items.forEach((it,i)=> it.classList.toggle('active-option', i===searchActiveIndex));
  const active = items[searchActiveIndex];
  active.scrollIntoView({block:'nearest'});
  searchInput.setAttribute('aria-activedescendant', active.id);
}
function runSearch(){
  const q = searchInput.value.trim().toLowerCase();
  searchActiveIndex = -1;
  if(!q){ closeSearchResults(); return; }
  const matches = SEARCH_INDEX.filter(it=>it.label.toLowerCase().includes(q)).slice(0,12);
  if(matches.length===0){
    searchResults.innerHTML = '<div class="sres-empty">Tidak ada hasil.</div>';
  }else{
    searchResults.innerHTML = matches.map((m,i)=>
      `<div class="sres-item" role="option" id="sres-opt-${i}" data-target="${m.target}" tabindex="-1"><span class="cat">${m.cat}</span>${escapeHtml(m.label)}</div>`
    ).join('');
  }
  searchResults.classList.add('show');
  searchInput.setAttribute('aria-expanded','true');
}
function selectSearchItem(item){
  if(!item) return;
  goTo(item.dataset.target);
  closeSearchResults();
  searchInput.value = '';
}
searchInput.addEventListener('input', runSearch);
searchInput.addEventListener('keydown', e=>{
  const isOpen = searchResults.classList.contains('show');
  if(e.key==='ArrowDown'){
    if(!isOpen){ runSearch(); }
    e.preventDefault();
    highlightSearchItem(searchActiveIndex+1);
  }else if(e.key==='ArrowUp'){
    if(isOpen){ e.preventDefault(); highlightSearchItem(searchActiveIndex-1); }
  }else if(e.key==='Enter'){
    if(isOpen && searchActiveIndex>=0){
      e.preventDefault();
      selectSearchItem(currentSearchItems()[searchActiveIndex]);
    }
  }else if(e.key==='Escape'){
    if(isOpen){ closeSearchResults(); }
    else { searchInput.value=''; searchInput.blur(); }
  }
});
searchResults.addEventListener('click', e=>{
  selectSearchItem(e.target.closest('.sres-item'));
});
document.addEventListener('click', e=>{
  if(!e.target.closest('.searchwrap')) closeSearchResults();
});
document.addEventListener('keydown', e=>{
  const isK = e.key==='k' || e.key==='K';
  if(isK && (e.ctrlKey || e.metaKey)){
    e.preventDefault();
    searchInput.focus();
    searchInput.select();
  }
});

/* ================= INIT: pulihkan pilihan terakhir dari IndexedDB ================= */
async function initApp(){
  // Profile is the landing page on every fresh app open; other panels remain available from navigation.
  goTo('profile', false);

  const mf = await uGet('mineralFilters', {rarity:'all', loc:'all'});
  document.getElementById('mineralFilter').value = mf.rarity;
  document.getElementById('mineralLocFilter').value = mf.loc;
  renderMinerals(mf.rarity, mf.loc);

  const co = await uGet('calcOddsState', null);
  if(co){
    document.getElementById('capInput').value = co.cap;
    document.getElementById('luckInput').value = co.luck;
    document.getElementById('oddsInput').value = co.basePercent;
    document.getElementById('rateInput').value = co.rate;
  }
  simRender();

  /* Render dulu slot equipment & rune (kosong) sebelum mineral calc dipulihkan,
     supaya rekomendasi otomatis (dipicu dari renderMineralCalc di bawah) punya
     elemen <select> yang siap diisi. Kit selalu ikut rekomendasi mineral yang
     aktif, jadi pilihan manual equipment/rune sebelumnya sengaja tidak dipulihkan. */
  const kl = await uGet('kitLoadoutState', null);
  if(kl && kl.ringCount) document.getElementById('kitRingCount').value = kl.ringCount;
  renderKitLoadout();

  const kr = await uGet('kitRuneState', null);
  if(kr && kr.count) document.getElementById('kitRuneCount').value = kr.count;
  renderKitRunes();
  await renderKitGear();

  const mc = await uGet('mineralCalcState', null);
  if(mc && mc.rarity){ document.getElementById('calcRarityFilterSelect').value = mc.rarity; }
  populateMineralCalcSelect();
  if(mc && mc.name){ const sel=document.getElementById('calcMineralSelect'); if([...sel.options].some(o=>o.value===mc.name)) sel.value = mc.name; }
  renderMineralCalc(false);
  syncDropTargetFromMineral();

  const savedBuilds = await uGet('museumBuilds', null);
  const savedActiveId = await uGet('museumActiveBuildId', null);
  if(Array.isArray(savedBuilds) && savedBuilds.length){
    MUSEUM_BUILDS = savedBuilds;
    museumActiveBuildId = savedActiveId;
  }
  ensureAtLeastOneMuseumBuild();
  renderMuseumBuildList();
  renderMuseumPlanner();
  const activeBuild = getActiveMuseumBuild();
  if(activeBuild.slots.some(s=>s && (s.ore || s.mod))) calcMuseumBuild();
  if(typeof initInternalDropCalculator==='function') initInternalDropCalculator();
  if(typeof updateExternalLoadoutSummary==='function') updateExternalLoadoutSummary();
}
/* Jangan panggil initApp() langsung — tunggu login/tamu dipilih dulu. */
bootstrapProfile();
</script>
</body>
</html>
